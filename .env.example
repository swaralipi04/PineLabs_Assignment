# Copy to .env and fill in. Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=
# Check the Groq console "Models" page for currently available model ids
LLM_MODEL_STRONG=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_BACKUP=qwen/qwen3.8-27b

# Relative dates ("last week") are resolved against this date (data ends 2026-11-15)
ANCHOR_DATE=2026-11-21

# Query safety controls
QUERY_TIMEOUT_S=10
MAX_RESULT_ROWS=5000
MAX_ESTIMATED_ROWS=20000000
